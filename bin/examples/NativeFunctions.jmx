<jmeterTestPlan version="1.2" properties="5.0" jmeter="BreakTest">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Native functions - inline examples" enabled="true">
      <stringProp name="TestPlan.comments">Requires a BreakTest build containing the 24 new native utility functions. Run, then open View Results Tree &gt; a sample &gt; Response Data &gt; Text. Edit the Java Request ResultData parameter to try different inline expressions. One user, two iterations, no network or external files. Assertions check the supplied examples; update them when changing inputs. Functional demonstration only: sampler timings do not measure function execution time. The last three lines compare existing JMeter functions.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Example inputs" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="sampleInput" elementType="Argument">
            <stringProp name="Argument.name">sampleInput</stringProp>
            <stringProp name="Argument.value">Hello BreakTest</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="sampleSize" elementType="Argument">
            <stringProp name="Argument.name">sampleSize</stringProp>
            <stringProp name="Argument.value">5</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Try every new function twice" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Two iterations" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">2</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <JavaSampler guiclass="JavaTestSamplerGui" testclass="JavaSampler" testname="All 24 new functions - open Response Data" enabled="true">
          <stringProp name="TestPlan.comments">All expressions are inline in ResultData below. No Groovy, scripting, server or plugin required. View Results Tree displays evaluated output. URL-safe Base64 uses U+083F to demonstrate the underscore character.</stringProp>
          <elementProp name="arguments" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Example inputs" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="Sleep_Time" elementType="Argument">
                <stringProp name="Argument.name">Sleep_Time</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="Sleep_Mask" elementType="Argument">
                <stringProp name="Argument.name">Sleep_Mask</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="ResponseCode" elementType="Argument">
                <stringProp name="Argument.name">ResponseCode</stringProp>
                <stringProp name="Argument.value">200</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="ResponseMessage" elementType="Argument">
                <stringProp name="Argument.name">ResponseMessage</stringProp>
                <stringProp name="Argument.value">OK</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="Status" elementType="Argument">
                <stringProp name="Argument.name">Status</stringProp>
                <stringProp name="Argument.value">OK</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="ResultData" elementType="Argument">
                <stringProp name="Argument.name">ResultData</stringProp>
                <stringProp name="Argument.value">Native BreakTest functions - evaluated inline

__chooseRandom = ${__chooseRandom(red,green,blue,sampleColor)}
__doubleSum = ${__doubleSum(1.5,2.5,3.0,sampleSum)}
__env = ${__env(BREAKTEST_NATIVE_SAMPLE_UNSET_7B46C3,,fallback)}
__isDefined = ${__isDefined(sampleInput)}
__MD5 = ${__MD5(test)}
__SHA256 = ${__SHA256(abc,sampleDigest)}
__base64Encode = ${__base64Encode(test string)}
__base64Decode = ${__base64Decode(dGVzdCBzdHJpbmc=)}
__base64UrlEncode = ${__base64UrlEncode(࠿)}
__base64UrlDecode = ${__base64UrlDecode(4KC_)}
__strLen = ${__strLen(${sampleInput})}
__substring = ${__substring(test string,5,8)}
__strReplace = ${__strReplace(banana apple orange,apple,dog)}
__strReplaceRegex = ${__strReplaceRegex(ab12cd34,[0-9]+,-)}
__uppercase = ${__uppercase(hello)}
__lowercase = ${__lowercase(HELLO)}
__iterationNum = ${__iterationNum()}
__if = ${__if(${sampleSize},5,ok,invalid)}
__caseFormat = ${__caseFormat(HTTPServer_name,LOWER_HYPHEN)}
__epochSeconds = ${__epochSeconds()}
__epochMilliSeconds = ${__epochMilliSeconds()}
__stringToHex = ${__stringToHex(Hello)}
__hexToString = ${__hexToString(48656c6c6f)}
__trim = ${__trim(  hello  )}

Stored results (from calls above):
color = ${sampleColor}
sum = ${sampleSum}
digest = ${sampleDigest}

Nested and escaped examples:
UTF-8 hex round trip = ${__hexToString(${__stringToHex(café)})}
literal comma = ${__strReplace(a\,b,\,,-)}

Existing functions for comparison:
__time = ${__time()}
__UUID = ${__UUID()}
__Random = ${__Random(1,100)}
</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="classname">org.apache.jmeter.protocol.java.test.JavaTest</stringProp>
        </JavaSampler>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Verify all 24 function outputs" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">(?m)^__chooseRandom = (red|green|blue)$</stringProp>
              <stringProp name="1">(?m)^__doubleSum = 7\.0$</stringProp>
              <stringProp name="2">(?m)^__env = fallback$</stringProp>
              <stringProp name="3">(?m)^__isDefined = 1$</stringProp>
              <stringProp name="4">(?m)^__MD5 = 098f6bcd4621d373cade4e832627b4f6$</stringProp>
              <stringProp name="5">(?m)^__SHA256 = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad$</stringProp>
              <stringProp name="6">(?m)^__base64Encode = dGVzdCBzdHJpbmc=$</stringProp>
              <stringProp name="7">(?m)^__base64Decode = test string$</stringProp>
              <stringProp name="8">(?m)^__base64UrlEncode = 4KC_$</stringProp>
              <stringProp name="9">(?m)^__base64UrlDecode = ࠿$</stringProp>
              <stringProp name="10">(?m)^__strLen = 15$</stringProp>
              <stringProp name="11">(?m)^__substring = str$</stringProp>
              <stringProp name="12">(?m)^__strReplace = banana dog orange$</stringProp>
              <stringProp name="13">(?m)^__strReplaceRegex = ab-cd-$</stringProp>
              <stringProp name="14">(?m)^__uppercase = HELLO$</stringProp>
              <stringProp name="15">(?m)^__lowercase = hello$</stringProp>
              <stringProp name="16">(?m)^__iterationNum = [12]$</stringProp>
              <stringProp name="17">(?m)^__if = ok$</stringProp>
              <stringProp name="18">(?m)^__caseFormat = http-server-name$</stringProp>
              <stringProp name="19">(?m)^__epochSeconds = [0-9]{10,}$</stringProp>
              <stringProp name="20">(?m)^__epochMilliSeconds = [0-9]{13,}$</stringProp>
              <stringProp name="21">(?m)^__stringToHex = 48656c6c6f$</stringProp>
              <stringProp name="22">(?m)^__hexToString = Hello$</stringProp>
              <stringProp name="23">(?m)^__trim = hello$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="Assertion.custom_message">A function returned an unexpected result. Check Response Data and confirm this BreakTest build includes the new functions.</stringProp>
          </ResponseAssertion>
          <hashTree />
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="No unresolved expressions" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">${</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">20</intProp>
          </ResponseAssertion>
          <hashTree />
        </hashTree>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <stringProp name="filename" />
      </ResultCollector>
      <hashTree />
    </hashTree>
  </hashTree>
</jmeterTestPlan>
