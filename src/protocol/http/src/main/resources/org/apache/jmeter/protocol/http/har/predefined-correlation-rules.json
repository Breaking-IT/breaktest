{
  "format": "breaktest-predefined-correlations-v1",
  "groups": [
    {
      "name": "OAuth",
      "rules": [
        {
          "id": "oauth-access-token",
          "name": "OAuth access token",
          "variableName": "oauth_access_token",
          "extractorType": "JSON_PATH",
          "responseField": "BODY",
          "expression": "$.access_token"
        },
        {
          "id": "oauth-refresh-token",
          "name": "OAuth refresh token",
          "variableName": "oauth_refresh_token",
          "extractorType": "JSON_PATH",
          "responseField": "BODY",
          "expression": "$.refresh_token"
        },
        {
          "id": "openid-id-token",
          "name": "OpenID Connect ID token",
          "variableName": "openid_id_token",
          "extractorType": "JSON_PATH",
          "responseField": "BODY",
          "expression": "$.id_token"
        },
        {
          "id": "oauth-code-header",
          "name": "OAuth authorization code",
          "variableName": "oauth_code",
          "extractorType": "REGEX",
          "responseField": "HEADERS",
          "expression": "(?i)[?&]code=([^&\\s]+)",
          "template": "$1$"
        },
        {
          "id": "oauth-state-header",
          "name": "OAuth state (redirect)",
          "variableName": "oauth_state",
          "extractorType": "REGEX",
          "responseField": "HEADERS",
          "expression": "(?i)[?&]state=([^&\\s]+)",
          "template": "$1$"
        },
        {
          "id": "oauth-code-form",
          "name": "OAuth authorization code (form)",
          "variableName": "oauth_code_form",
          "extractorType": "REGEX",
          "responseField": "BODY",
          "expression": "(?i)<input(?=[^>]{0,600}\\sname=[\"']code[\"'])[^>]{0,600}\\svalue=[\"']([^\"']+)[\"']",
          "template": "$1$"
        },
        {
          "id": "oauth-state-form",
          "name": "OAuth state (form)",
          "variableName": "oauth_state_form",
          "extractorType": "REGEX",
          "responseField": "BODY",
          "expression": "(?i)<input(?=[^>]{0,600}\\sname=[\"']state[\"'])[^>]{0,600}\\svalue=[\"']([^\"']+)[\"']",
          "template": "$1$"
        },
        {
          "id": "openid-nonce-form",
          "name": "OpenID Connect nonce",
          "variableName": "openid_nonce",
          "extractorType": "REGEX",
          "responseField": "BODY",
          "expression": "(?i)<input(?=[^>]{0,600}\\sname=[\"']nonce[\"'])[^>]{0,600}\\svalue=[\"']([^\"']+)[\"']",
          "template": "$1$"
        }
      ]
    },
